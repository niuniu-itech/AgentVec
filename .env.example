# Export these variables in your shell; AgentVec does not load .env automatically.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=
AGENTVEC_CACHE_DIR=

# Cross-build and QEMU host (e.g. an x86 Linux server).
AGENTVEC_SERVER_HOST=
AGENTVEC_SERVER_USER=
AGENTVEC_SERVER_PORT=22
AGENTVEC_SERVER_KEY=
AGENTVEC_SERVER_GCC=riscv64-linux-gnu-gcc
AGENTVEC_SERVER_QEMU=qemu-riscv64

# Native RISC-V board.
AGENTVEC_BOARD_HOST=
AGENTVEC_BOARD_USER=
AGENTVEC_BOARD_PORT=22
AGENTVEC_BOARD_KEY=
AGENTVEC_REMOTE_ROOT=/tmp/agentvec
# Password authentication also accepts AGENTVEC_SERVER_PASSWORD / AGENTVEC_BOARD_PASSWORD.

# Ascend310P1 host with an installed CANN toolkit.
AGENTVEC_ASCEND_HOST=
AGENTVEC_ASCEND_USER=
AGENTVEC_ASCEND_PORT=22
AGENTVEC_ASCEND_KEY=
# Optional alternative: AGENTVEC_ASCEND_PASSWORD.
AGENTVEC_ASCEND_SETUP=/usr/local/Ascend/ascend-toolkit/set_env.sh
AGENTVEC_ASCEND_CMAKE=cmake
