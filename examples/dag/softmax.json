      "equiv": "tolerance"
    },
    {
      "name": "denom",
      "pattern": "reduce",
      "formula": "shifted",
      "reduce_op": "sum",
      "equiv": "tolerance"
    },
    {
      "name": "y",
      "pattern": "map",
      "formula": "shifted/denom",
      "reduce_op": null,
      "equiv": "tolerance"
    }
  ]
}
